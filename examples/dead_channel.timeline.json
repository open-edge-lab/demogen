{
  "name": "dead-channel",
  "bpm": 90,
  "beats_per_bar": 4,
  "loop": true,
  "common": "dead_channel_common.glsl",
  "render": { "profile": "modern" },
  "post": { "bloom": { "threshold": 0.8, "intensity": 0.35 } },
  "quality": { "target_fps": 60, "min_scale": 0.5 },
  "scenes": [
    { "id": "card", "src": "shaders/dead_channel_card.glsl", "start_bar": 0, "bars": 8, "transition_in": "cut", "transition_bars": 0 },
    { "id": "breach", "src": "shaders/dead_channel_breach.glsl", "start_bar": 8, "bars": 8, "transition_in": "cut", "transition_bars": 0 },
    { "id": "hijack", "src": "shaders/dead_channel_hijack.glsl", "start_bar": 16, "bars": 8, "transition_in": "cut", "transition_bars": 0 },
    { "id": "return", "src": "shaders/dead_channel_return.glsl", "start_bar": 24, "bars": 8, "transition_in": "cut", "transition_bars": 0 }
  ]
}
