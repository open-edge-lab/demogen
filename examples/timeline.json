{
  "name": "demogen-m1",
  "bpm": 120,
  "beats_per_bar": 4,
  "loop": false,
  "common": "common.glsl",
  "text": "HELLO FROM DEMOGEN! RETRO SCENE ON CPU TOO! 1234567890 !?.,:-",
  "render": {
    "profile": "modern",
    "overrides": { "s4": "retro" },
    "retro": { "internal_resolution": [320, 180], "upscale": "nearest" }
  },
  "post": { "bloom": { "threshold": 0.8, "intensity": 0.5 } },
  "quality": { "target_fps": 60, "min_scale": 0.5 },
  "scenes": [
    { "id": "s1", "src": "shaders/tunnel.glsl", "start_bar": 0, "bars": 8, "transition_in": "cut", "transition_bars": 0 },
    { "id": "s2", "src": "shaders/ifs.glsl", "start_bar": 8, "bars": 8, "transition_in": "crossfade", "transition_bars": 1 },
    { "id": "s3", "src": "shaders/terrain.glsl", "start_bar": 16, "bars": 8, "transition_in": "flash", "transition_bars": 1 },
    { "id": "s4", "src": "shaders/plasma_retro.glsl", "start_bar": 24, "bars": 8, "transition_in": "crossfade", "transition_bars": 1 }
  ]
}
