{
  "name": "@demogen/player",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build:core && npm run build:harness",
    "build:core": "esbuild src/index.ts --bundle --format=iife --global-name=demogenPlayer --minify --outfile=dist/demogen-player.min.js",
    "build:harness": "esbuild src/harness.ts --bundle --format=iife --global-name=demogenHarness --outfile=dist/demogen-harness.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.20.0",
    "typescript": "^5.4.0",
    "vitest": "^1.5.0"
  }
}
